# Android 16/17 userspace on top of a device defconfig: fuse-bpf for the
# FUSE daemon and the tc/memory options netd and lmkd use. BPF_LSM stays
# off: it needs BPF_EVENTS (tracing), which this config does not enable.
CONFIG_FUSE_BPF=y
# CONFIG_BPF_LSM is not set
CONFIG_PSI=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_SECURITYFS=y
CONFIG_HIDRAW=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_BPF=y
