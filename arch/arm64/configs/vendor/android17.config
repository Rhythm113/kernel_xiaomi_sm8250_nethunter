# Android 16/17 userspace on top of a device defconfig: fuse-bpf for the
# FUSE daemon, BPF LSM for netbpfload, and the tc/memory options netd and
# lmkd use.
CONFIG_FUSE_BPF=y
CONFIG_BPF_LSM=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor,bpf"
CONFIG_PSI=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_SECURITYFS=y
CONFIG_HIDRAW=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_BPF=y
